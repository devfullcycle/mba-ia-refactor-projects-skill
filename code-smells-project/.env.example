# Copie para .env e ajuste os valores.
SECRET_KEY=troque-por-uma-chave-aleatoria-longa
TOKEN_TTL_SEGUNDOS=3600
APP_ENV=desenvolvimento
DEBUG=false
HOST=127.0.0.1
PORT=5000
LOG_LEVEL=INFO

# Origens autorizadas para CORS, separadas por vírgula. Vazio = CORS desabilitado.
CORS_ORIGINS=http://localhost:3000

# Caminho relativo à raiz do projeto (ou absoluto).
DB_PATH=loja.db

# Seed de exemplo: só roda com SEED_DB=true e APP_ENV diferente de "producao".
# Senhas em branco são geradas aleatoriamente e exibidas uma vez no log.
SEED_DB=true
SEED_ADMIN_PASSWORD=
SEED_CLIENTE_PASSWORD=

# Deixe vazio para desabilitar /admin/reset-db e /admin/query.
# Quando definido, envie o valor no header X-Admin-Token.
ADMIN_TOKEN=
