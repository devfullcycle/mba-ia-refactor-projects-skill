# Copie para .env (ou exporte no shell) e ajuste os valores. Nunca commite segredos reais.
APP_ENV=development
SECRET_KEY=troque-por-um-valor-aleatorio-longo
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000
LOG_LEVEL=INFO
DATABASE_PATH=loja.db
SEED_DATABASE=true
CORS_ORIGINS=*
# Habilita /admin/reset-db e /admin/query (header X-Admin-Token). Vazio = desabilitado.
ADMIN_TOKEN=
