# Copie para .env e preencha. Nenhum valor real deve ser versionado.
# Em produção (APP_ENV=production) a aplicação recusa iniciar sem SECRET_KEY.

APP_ENV=development
SECRET_KEY=
DATABASE_PATH=loja.db

HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=false

LOG_LEVEL=INFO
APP_VERSION=1.0.0

# Origens permitidas para CORS, separadas por vírgula (evite "*" em produção)
CORS_ORIGINS=*

# Popular o banco com dados de demonstração quando estiver vazio
SEED_ON_INIT=true
