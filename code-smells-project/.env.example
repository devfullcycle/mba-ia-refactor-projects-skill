# Copie para o ambiente (export VAR=...) — a aplicação lê os.environ diretamente.

# Chave de assinatura do Flask. Se vazia, uma chave aleatória efêmera é gerada a cada boot.
SECRET_KEY=
# Token exigido no cabeçalho X-Admin-Token para /admin/*. Se vazio, os endpoints admin respondem 403.
ADMIN_TOKEN=
# Debug do Flask (nunca habilite em produção)
FLASK_DEBUG=false
# Endereço/porta do servidor (use HOST=0.0.0.0 para expor na rede)
HOST=127.0.0.1
PORT=5000
# Caminho do arquivo SQLite
DATABASE_PATH=loja.db
# Nome do ambiente retornado em /health
APP_ENV=desenvolvimento
# Origens CORS permitidas, separadas por vírgula ("*" libera todas)
CORS_ORIGINS=*
