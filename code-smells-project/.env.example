# Copie para .env (não versionado) ou exporte no ambiente. Valores abaixo são exemplos fictícios.
APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=5000
APP_ENV=producao
DB_PATH=loja.db
# Obrigatória em produção; sem ela, uma chave aleatória é gerada a cada boot.
SECRET_KEY=<gere-uma-chave-aleatoria>
TOKEN_MAX_AGE=3600
# Lista separada por vírgula; vazio = nenhuma origem externa liberada.
CORS_ORIGINS=http://localhost:3000
# Senhas do seed de usuários de exemplo (somente desenvolvimento/teste).
SEED_ADMIN_PASSWORD=<senha-do-admin-de-exemplo>
SEED_CLIENTE_PASSWORD=<senha-dos-clientes-de-exemplo>
# Habilita POST /admin/reset-db (além do token de admin).
ALLOW_DESTRUCTIVE=false
LOG_LEVEL=INFO
