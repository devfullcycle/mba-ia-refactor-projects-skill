{
  "info": {
    "name": "code-smells-project",
    "_postman_id": "6d3a1f0d-5f4c-4f2b-9bb5-7c8f7c70f201",
    "description": "Collection for the Loja API endpoints. Login stores auth_token when the API returns one, and also persists user_id/user_email for follow-up requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:5000"
    },
    {
      "key": "admin_token",
      "value": "local-admin-token"
    },
    {
      "key": "auth_token",
      "value": ""
    },
    {
      "key": "user_id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": ["{{base_url}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "Root",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/",
          "host": ["{{base_url}}"],
          "path": [""]
        }
      }
    },
    {
      "name": "Produtos",
      "item": [
        {
          "name": "Listar produtos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/produtos",
              "host": ["{{base_url}}"],
              "path": ["produtos"]
            }
          }
        },
        {
          "name": "Buscar produto por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/produtos/{{produto_id}}",
              "host": ["{{base_url}}"],
              "path": ["produtos", "{{produto_id}}"]
            }
          }
        },
        {
          "name": "Buscar produtos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/produtos/busca?q={{busca}}&categoria={{categoria}}&preco_min={{preco_min}}&preco_max={{preco_max}}",
              "host": ["{{base_url}}"],
              "path": ["produtos", "busca"],
              "query": [
                {
                  "key": "q",
                  "value": "{{busca}}"
                },
                {
                  "key": "categoria",
                  "value": "{{categoria}}"
                },
                {
                  "key": "preco_min",
                  "value": "{{preco_min}}"
                },
                {
                  "key": "preco_max",
                  "value": "{{preco_max}}"
                }
              ]
            }
          }
        },
        {
          "name": "Criar produto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Mesa d'agua\",\n  \"descricao\": \"Produto criado via Postman\",\n  \"preco\": 12.5,\n  \"estoque\": 4,\n  \"categoria\": \"geral\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/produtos",
              "host": ["{{base_url}}"],
              "path": ["produtos"]
            }
          }
        },
        {
          "name": "Atualizar produto",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Mesa d'agua\",\n  \"descricao\": \"Atualizado via Postman\",\n  \"preco\": 15,\n  \"estoque\": 3,\n  \"categoria\": \"geral\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/produtos/{{produto_id}}",
              "host": ["{{base_url}}"],
              "path": ["produtos", "{{produto_id}}"]
            }
          }
        },
        {
          "name": "Deletar produto",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/produtos/{{produto_id}}",
              "host": ["{{base_url}}"],
              "path": ["produtos", "{{produto_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Usuarios",
      "item": [
        {
          "name": "Listar usuarios",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/usuarios",
              "host": ["{{base_url}}"],
              "path": ["usuarios"]
            }
          }
        },
        {
          "name": "Buscar usuario por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/usuarios/{{user_id}}",
              "host": ["{{base_url}}"],
              "path": ["usuarios", "{{user_id}}"]
            }
          }
        },
        {
          "name": "Criar usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Novo Usuario\",\n  \"email\": \"novo@email.com\",\n  \"senha\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/usuarios",
              "host": ["{{base_url}}"],
              "path": ["usuarios"]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const token = json.token || json.access_token || (json.dados && (json.dados.token || json.dados.access_token));",
                  "if (token) {",
                  "  pm.environment.set('auth_token', token);",
                  "}",
                  "if (json.dados && json.dados.id !== undefined) {",
                  "  pm.environment.set('user_id', String(json.dados.id));",
                  "}",
                  "if (json.dados && json.dados.email) {",
                  "  pm.environment.set('user_email', json.dados.email);",
                  "}",
                  "pm.test('Login succeeded', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@loja.com\",\n  \"senha\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": ["{{base_url}}"],
              "path": ["login"]
            }
          }
        }
      ]
    },
    {
      "name": "Pedidos",
      "item": [
        {
          "name": "Criar pedido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario_id\": {{user_id}},\n  \"itens\": [\n    {\"produto_id\": 1, \"quantidade\": 1}\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/pedidos",
              "host": ["{{base_url}}"],
              "path": ["pedidos"]
            }
          }
        },
        {
          "name": "Listar pedidos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/pedidos",
              "host": ["{{base_url}}"],
              "path": ["pedidos"]
            }
          }
        },
        {
          "name": "Listar pedidos do usuario",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/pedidos/usuario/{{user_id}}",
              "host": ["{{base_url}}"],
              "path": ["pedidos", "usuario", "{{user_id}}"]
            }
          }
        },
        {
          "name": "Atualizar status do pedido",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"aprovado\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/pedidos/{{pedido_id}}/status",
              "host": ["{{base_url}}"],
              "path": ["pedidos", "{{pedido_id}}", "status"]
            }
          }
        }
      ]
    },
    {
      "name": "Relatorios",
      "item": [
        {
          "name": "Vendas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/relatorios/vendas",
              "host": ["{{base_url}}"],
              "path": ["relatorios", "vendas"]
            }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Reset database",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Admin-Token",
                "value": "{{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/reset-db",
              "host": ["{{base_url}}"],
              "path": ["admin", "reset-db"]
            }
          }
        },
        {
          "name": "Run select query",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Admin-Token",
                "value": "{{admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sql\": \"SELECT COUNT(*) AS total FROM produtos\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/admin/query",
              "host": ["{{base_url}}"],
              "path": ["admin", "query"]
            }
          }
        }
      ]
    }
  ]
}
