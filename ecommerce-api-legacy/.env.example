# Porta HTTP (padrão: 3000)
PORT=3000

# Arquivo do SQLite (padrão: ':memory:', recria os dados a cada boot)
DATABASE_FILE=:memory:

# Token exigido no header x-admin-token das rotas administrativas
# (GET /api/admin/financial-report e DELETE /api/users/:id).
# Se vazio, essas rotas respondem 403. Gere um valor longo e aleatório.
ADMIN_TOKEN=
