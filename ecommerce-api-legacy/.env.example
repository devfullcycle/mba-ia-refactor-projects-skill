# Copie para .env e ajuste os valores.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ":memory:" (padrão) recria o banco a cada boot; use um arquivo (ex.: lms.db) para persistir.
DB_PATH=:memory:
SEED_DB=true
# Senha do usuário de exemplo (leonan@fullcycle.com.br). Vazio = senha aleatória.
SEED_USER_PASSWORD=

# Chave do gateway de pagamento (obrigatória com NODE_ENV=production).
PAYMENT_GATEWAY_KEY=

# Deixe vazio para desabilitar /api/admin/financial-report e DELETE /api/users/:id.
# Quando definido, envie o valor no header X-Admin-Token.
ADMIN_TOKEN=
