# Copie para .env e preencha. Nenhum valor real deve ser versionado.

APP_ENV=development
PORT=3000
LOG_LEVEL=info

# Caminho do arquivo SQLite. ":memory:" recria o banco a cada boot.
DB_FILE=:memory:
SEED_ON_BOOT=true

# Chave do gateway de pagamento — obrigatória quando APP_ENV=production
PAYMENT_GATEWAY_KEY=

# Chave de acesso às rotas administrativas (header x-api-key).
# Sem ela, /api/admin/* e DELETE /api/users/:id respondem 401.
ADMIN_API_KEY=

PASSWORD_MIN_LENGTH=6

# Senha do usuário de demonstração criado pelo seed (apenas ambientes não-produtivos)
SEED_USER_PASSWORD=
