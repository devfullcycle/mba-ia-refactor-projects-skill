# Exporte estas variáveis (ou use um gerenciador de env). Nunca commite valores reais.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_FILE=:memory:
DATABASE_VERBOSE=false
DATABASE_SEED=true
PAYMENT_GATEWAY_KEY=
SMTP_USER=
# Habilita /api/admin/financial-report e DELETE /api/users/:id (header X-Admin-Token). Vazio = desabilitado.
ADMIN_TOKEN=
