# Copie para .env e ajuste. NUNCA versione o .env real.
PORT=3000

# Banco (SQLite in-memory por padrão; credenciais só se migrar para outro engine)
DB_PATH=:memory:
DB_USER=
DB_PASS=

# Segredos de integração
PAYMENT_GATEWAY_KEY=pk_test_xxxxxxxxxxxxxxxx
SMTP_USER=no-reply@example.com

# Token para as rotas administrativas (header: x-admin-token)
ADMIN_TOKEN=defina-um-token-forte-aqui
