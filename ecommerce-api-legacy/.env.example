# Porta HTTP
PORT=3000
# Caminho do banco SQLite (":memory:" = em memória, recriado e populado a cada boot)
DB_PATH=:memory:
# Chave do gateway de pagamento (nunca commitar o valor real)
PAYMENT_GATEWAY_KEY=
# Token exigido no header X-Admin-Token para rotas administrativas; vazio = rotas bloqueadas (403)
ADMIN_TOKEN=
# development | production (development ativa o modo verbose do sqlite3)
NODE_ENV=development
# error | warn | info | debug
LOG_LEVEL=info
