# Testes manuais da task-manager-api (extensão "REST Client" do VS Code).
# Antes: pip install -r requirements.txt && python seed.py && python app.py
# Clique em "Send Request" acima de cada bloco. Blocos separados por ###.

@baseUrl = http://localhost:5000
@contentType = application/json

###############################################################
# Saúde
###############################################################

### Index
GET {{baseUrl}}/

### Health
GET {{baseUrl}}/health

###############################################################
# Login (rode antes das rotas protegidas)
# Senhas: as impressas pelo `python seed.py` (ou SEED_PASSWORD do .env).
# joao@email.com (admin), maria@email.com (user), pedro@email.com (manager)
###############################################################

@adminPassword = cole-aqui-a-senha-do-joao
@userPassword = cole-aqui-a-senha-da-maria

### Login como admin (guarda o token em {{adminToken}})
# @name loginAdmin
POST {{baseUrl}}/login
Content-Type: {{contentType}}

{
  "email": "joao@email.com",
  "password": "{{adminPassword}}"
}

###
@adminToken = {{loginAdmin.response.body.token}}

### Login como usuário comum (guarda o token em {{userToken}})
# @name loginUser
POST {{baseUrl}}/login
Content-Type: {{contentType}}

{
  "email": "maria@email.com",
  "password": "{{userPassword}}"
}

###
@userToken = {{loginUser.response.body.token}}

### Login com senha errada -> 401
POST {{baseUrl}}/login
Content-Type: {{contentType}}

{
  "email": "joao@email.com",
  "password": "errada"
}

###############################################################
# Tasks
###############################################################

### Listar tasks
GET {{baseUrl}}/tasks

### Buscar task por id
GET {{baseUrl}}/tasks/1

### Task inexistente -> 404
GET {{baseUrl}}/tasks/999

### Criar task SEM token -> 401
POST {{baseUrl}}/tasks
Content-Type: {{contentType}}

{
  "title": "Sem login"
}

### Criar task como usuário comum (vira dona) -> 201
# @name createTask
POST {{baseUrl}}/tasks
Content-Type: {{contentType}}
Authorization: Bearer {{userToken}}

{
  "title": "Minha nova task",
  "description": "Criada pelo REST Client",
  "priority": 2,
  "category_id": 1,
  "due_date": "2030-01-31",
  "tags": ["manual", "teste"]
}

###
@newTaskId = {{createTask.response.body.id}}

### Criar task para OUTRO usuário como usuário comum -> 403
POST {{baseUrl}}/tasks
Content-Type: {{contentType}}
Authorization: Bearer {{userToken}}

{
  "title": "Task para o João",
  "user_id": 1
}

### Criar task inválida (título curto) -> 400
POST {{baseUrl}}/tasks
Content-Type: {{contentType}}
Authorization: Bearer {{userToken}}

{
  "title": "ab"
}

### Criar task com prioridade não numérica -> 400
POST {{baseUrl}}/tasks
Content-Type: {{contentType}}
Authorization: Bearer {{userToken}}

{
  "title": "Prioridade inválida",
  "priority": "alta"
}

### Atualizar task alheia (task 1 é do João) como usuário comum -> 403
PUT {{baseUrl}}/tasks/1
Content-Type: {{contentType}}
Authorization: Bearer {{userToken}}

{
  "title": "Não é minha"
}

### Atualizar task criada (dona) -> 200
PUT {{baseUrl}}/tasks/{{newTaskId}}
Content-Type: {{contentType}}
Authorization: Bearer {{userToken}}

{
  "status": "in_progress",
  "priority": 1
}

### Buscar tasks (texto + status)
GET {{baseUrl}}/tasks/search?q=Config&status=pending

### Buscar tasks por prioridade e usuário
GET {{baseUrl}}/tasks/search?priority=1&user_id=1

### Busca com prioridade inválida -> 400
GET {{baseUrl}}/tasks/search?priority=abc

### Estatísticas de tasks
GET {{baseUrl}}/tasks/stats

### Deletar task SEM token -> 401
DELETE {{baseUrl}}/tasks/{{newTaskId}}

### Deletar task alheia como usuário comum -> 403
DELETE {{baseUrl}}/tasks/1
Authorization: Bearer {{userToken}}

### Deletar task COM token da dona -> 200
DELETE {{baseUrl}}/tasks/{{newTaskId}}
Authorization: Bearer {{userToken}}

###############################################################
# Usuários
###############################################################

### Listar usuários SEM token -> 401
GET {{baseUrl}}/users

### Listar usuários (sem campo password)
GET {{baseUrl}}/users
Authorization: Bearer {{userToken}}

### Buscar usuário com suas tasks
GET {{baseUrl}}/users/1
Authorization: Bearer {{userToken}}

### Tasks de um usuário (paginação opcional)
GET {{baseUrl}}/users/1/tasks?limit=2&offset=0
Authorization: Bearer {{userToken}}

### Criar usuário comum -> 201
# @name createUser
POST {{baseUrl}}/users
Content-Type: {{contentType}}

{
  "name": "Ana Teste",
  "email": "ana.teste@email.com",
  "password": "senha123"
}

###
@newUserId = {{createUser.response.body.id}}

### Criar usuário com e-mail repetido -> 409
POST {{baseUrl}}/users
Content-Type: {{contentType}}

{
  "name": "Ana Teste",
  "email": "ana.teste@email.com",
  "password": "senha123"
}

### Criar admin SEM token de admin -> 401
POST {{baseUrl}}/users
Content-Type: {{contentType}}

{
  "name": "Admin Falso",
  "email": "falso@email.com",
  "password": "senha123",
  "role": "admin"
}

### Criar admin COM token de admin -> 201
POST {{baseUrl}}/users
Content-Type: {{contentType}}
Authorization: Bearer {{adminToken}}

{
  "name": "Admin Legítimo",
  "email": "admin.legitimo@email.com",
  "password": "senha123",
  "role": "admin"
}

### Atualizar usuário SEM token -> 401
PUT {{baseUrl}}/users/{{newUserId}}
Content-Type: {{contentType}}

{
  "name": "Sem login"
}

### Usuário comum tentando virar admin -> 403
PUT {{baseUrl}}/users/2
Content-Type: {{contentType}}
Authorization: Bearer {{userToken}}

{
  "role": "admin"
}

### Usuário comum alterando outro usuário -> 403
PUT {{baseUrl}}/users/1
Content-Type: {{contentType}}
Authorization: Bearer {{userToken}}

{
  "password": "tentativa123"
}

### Admin atualiza usuário -> 200
PUT {{baseUrl}}/users/{{newUserId}}
Content-Type: {{contentType}}
Authorization: Bearer {{adminToken}}

{
  "name": "Ana Atualizada"
}

### Deletar usuário com token de usuário comum -> 403
DELETE {{baseUrl}}/users/{{newUserId}}
Authorization: Bearer {{userToken}}

### Deletar usuário com token de admin -> 200
DELETE {{baseUrl}}/users/{{newUserId}}
Authorization: Bearer {{adminToken}}

###############################################################
# Categorias
###############################################################

### Listar categorias (com task_count)
GET {{baseUrl}}/categories

### Criar categoria como usuário comum -> 403
POST {{baseUrl}}/categories
Content-Type: {{contentType}}
Authorization: Bearer {{userToken}}

{
  "name": "Não autorizada"
}

### Criar categoria (admin) -> 201
# @name createCategory
POST {{baseUrl}}/categories
Content-Type: {{contentType}}
Authorization: Bearer {{adminToken}}

{
  "name": "Teste manual",
  "description": "Categoria criada pelo REST Client",
  "color": "#123456"
}

###
@newCategoryId = {{createCategory.response.body.id}}

### Criar categoria com cor inválida -> 400
POST {{baseUrl}}/categories
Content-Type: {{contentType}}
Authorization: Bearer {{adminToken}}

{
  "name": "Cor ruim",
  "color": "vermelho"
}

### Atualizar categoria (admin)
PUT {{baseUrl}}/categories/{{newCategoryId}}
Content-Type: {{contentType}}
Authorization: Bearer {{adminToken}}

{
  "name": "Teste manual (editada)"
}

### Deletar categoria SEM token -> 401
DELETE {{baseUrl}}/categories/{{newCategoryId}}

### Deletar categoria como usuário comum -> 403
DELETE {{baseUrl}}/categories/{{newCategoryId}}
Authorization: Bearer {{userToken}}

### Deletar categoria (admin) -> 200
DELETE {{baseUrl}}/categories/{{newCategoryId}}
Authorization: Bearer {{adminToken}}

###############################################################
# Relatórios
###############################################################

### Resumo geral como usuário comum -> 403
GET {{baseUrl}}/reports/summary
Authorization: Bearer {{userToken}}

### Resumo geral (admin/manager)
GET {{baseUrl}}/reports/summary
Authorization: Bearer {{adminToken}}

### Relatório de outro usuário como usuário comum -> 403
GET {{baseUrl}}/reports/user/1
Authorization: Bearer {{userToken}}

### Relatório de um usuário (admin)
GET {{baseUrl}}/reports/user/1
Authorization: Bearer {{adminToken}}

### Relatório de usuário inexistente -> 404
GET {{baseUrl}}/reports/user/999
Authorization: Bearer {{adminToken}}
