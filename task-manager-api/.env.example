# Copie para .env e ajuste. Nenhum valor real deve ser versionado.
# Obrigatória em produção. Sem ela, uma chave aleatória é gerada a cada boot.
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DATABASE_URL=sqlite:///tasks.db
DEBUG=false
HOST=127.0.0.1
PORT=5000
# Em produção, liste as origens permitidas (ex.: https://app.exemplo.com).
CORS_ORIGINS=*
TOKEN_MAX_AGE=86400
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Opcional: senha dos usuários do seed.py (vazio = senhas aleatórias impressas no seed).
SEED_PASSWORD=
