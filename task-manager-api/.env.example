# Copy to .env and fill in. Every variable is optional in development.

# Signs the auth tokens issued by POST /login. If unset, a random key is generated per process
# (tokens stop working after a restart). Always set it in production.
SECRET_KEY=

# SQLAlchemy URL. Relative SQLite paths are created under instance/.
DATABASE_URL=sqlite:///tasks.db

# Server
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000

# Comma-separated list of allowed origins, or * (default).
CORS_ORIGINS=*

# Auth token lifetime in seconds (default 8h).
TOKEN_MAX_AGE=28800

# SMTP for e-mail notifications (notifications are skipped when unset).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
