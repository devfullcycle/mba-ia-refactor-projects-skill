# Copie para `.env` e ajuste os valores. Nunca commite o `.env` real.

# Obrigatório em produção: chave usada para assinar JWT/sessões.
# Sem valor, a aplicação gera uma chave aleatória em boot (tokens não sobrevivem a restart).
SECRET_KEY=

# Banco de dados (default: SQLite local `tasks.db`)
DATABASE_URL=sqlite:///tasks.db

# Servidor
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=false

# Autenticação default deny: rotas de escrita exigem Bearer JWT por padrão.
# Gestão de usuários (POST/PUT/DELETE e listagem) exige papel `admin`.
AUTH_REQUIRED=true
JWT_EXPIRATION_SECONDS=86400
