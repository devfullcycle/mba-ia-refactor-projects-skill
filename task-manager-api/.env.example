# Copy to .env and fill in. Every variable is optional in development.

# Secret used to sign auth tokens. If empty, a random key is generated at startup
# (tokens are invalidated on every restart) — always set it in production.
SECRET_KEY=

# SQLAlchemy URL. Relative SQLite paths are created under instance/.
DATABASE_URL=sqlite:///tasks.db

# Server
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000

# Comma-separated list of allowed origins ("*" = any origin).
CORS_ORIGINS=*

# Auth token lifetime in seconds.
TOKEN_MAX_AGE=86400

# SMTP for e-mail notifications (disabled while SMTP_HOST/SMTP_USER are empty).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
