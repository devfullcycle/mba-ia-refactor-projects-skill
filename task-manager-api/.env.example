# Copie para .env e ajuste os valores.
SECRET_KEY=troque-por-uma-chave-aleatoria-longa
TOKEN_TTL_SECONDS=3600
APP_ENV=development
DEBUG=false
HOST=127.0.0.1
PORT=5000
LOG_LEVEL=INFO

# Origens autorizadas para CORS, separadas por vírgula. Vazio = CORS desabilitado.
CORS_ORIGINS=http://localhost:3000

# Padrão: sqlite em instance/tasks.db (mesmo arquivo usado pela versão legada).
DATABASE_URL=

# Paginação opcional nas listagens (?page=&per_page=).
DEFAULT_PER_PAGE=20
MAX_PER_PAGE=100

# Notificações por e-mail (desabilitadas por padrão).
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Seed de exemplo: só roda com SEED_DB=true e APP_ENV diferente de "production".
# Senhas em branco são geradas aleatoriamente e exibidas uma vez no log.
SEED_DB=true
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
SEED_MANAGER_PASSWORD=
