# Copie para .env e preencha. Nenhum valor real deve ser versionado.
# Em produção (APP_ENV=production) a aplicação recusa iniciar sem SECRET_KEY.

APP_ENV=development
SECRET_KEY=
DATABASE_URI=sqlite:///tasks.db

HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=false

LOG_LEVEL=INFO
APP_VERSION=1.0

# Origens permitidas para CORS, separadas por vírgula (evite "*" em produção)
CORS_ORIGINS=*

# Política de credenciais
PASSWORD_MIN_LENGTH=8
TOKEN_TTL_SECONDS=3600

# SMTP das notificações. Sem estas variáveis, as notificações vão para o log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
