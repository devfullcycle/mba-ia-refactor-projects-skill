# Copie para .env e preencha. Nunca versione o .env real.

# OBRIGATÓRIO: chave usada para assinar os tokens de login.
# Gere uma com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Opcionais (valores padrão entre parênteses)
# DATABASE_URL=sqlite:///tasks.db
# APP_DEBUG=false            # nunca habilite em produção
# HOST=127.0.0.1             # use 0.0.0.0 apenas se precisar expor na rede
# PORT=5000
# CORS_ORIGINS=*             # ex.: https://meu-front.exemplo.com
# TOKEN_MAX_AGE_SECONDS=86400
# LOG_LEVEL=INFO

# Notificações por e-mail (opcional; sem credenciais o envio é ignorado)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=
# EMAIL_PASSWORD=
