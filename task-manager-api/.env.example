# Obrigatório para boot e assinatura de tokens. Gere um valor longo e aleatório.
TASK_MANAGER_SECRET_KEY=replace-with-a-random-secret

# Configuração operacional opcional.
TASK_MANAGER_DATABASE_URI=sqlite:///tasks.db
TASK_MANAGER_HOST=127.0.0.1
TASK_MANAGER_PORT=5000
TASK_MANAGER_DEBUG=false
TASK_MANAGER_CORS_ORIGINS=http://localhost:3000
TASK_MANAGER_AUTH_TOKEN_TTL_SECONDS=3600

# Obrigatório somente para executar seed.py.
TASK_MANAGER_SEED_ADMIN_PASSWORD=replace-admin-password
TASK_MANAGER_SEED_USER_PASSWORD=replace-user-password
TASK_MANAGER_SEED_MANAGER_PASSWORD=replace-manager-password

# Obrigatório somente se o adapter SMTP for usado.
TASK_MANAGER_SMTP_HOST=smtp.example.com
TASK_MANAGER_SMTP_PORT=587
TASK_MANAGER_SMTP_USER=replace-smtp-user
TASK_MANAGER_SMTP_PASSWORD=replace-smtp-password
TASK_MANAGER_SMTP_TIMEOUT_SECONDS=10
