# Copie para .env e ajuste. Nenhum valor real deve ser versionado.

# Chave que assina os tokens de login. Sem ela, uma chave aleatória é gerada a cada boot.
SECRET_KEY=
# Validade do token de login, em segundos (padrão: 8h)
TOKEN_MAX_AGE=28800

# Banco (relativo a instance/ para SQLite)
DATABASE_URL=sqlite:///tasks.db

# Servidor
DEBUG=false
HOST=127.0.0.1
PORT=5000
# "*" ou lista separada por vírgula (ex.: https://app.exemplo.com,https://admin.exemplo.com)
CORS_ORIGINS=*

# SMTP (notificações por e-mail; desabilitado se SMTP_HOST/SMTP_USER vazios)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
